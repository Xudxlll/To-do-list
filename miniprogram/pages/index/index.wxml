<navigation-bar title="今天干什么" back="{{true}}" customBack="{{returnToPartnerWelcome}}" bind:back="onNavBack" color="black" background="#FFF5F5"></navigation-bar>

<view class="main-layout">
  <scroll-view class="left-sidebar" scroll-y show-scrollbar="{{false}}">
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="sidebar-item {{currentCategoryId === item.id ? 'active' : ''}} {{draggingOptionId || dragSaving ? 'disabled' : ''}}"
      bind:tap="onSelectCategory"
      data-id="{{item.id}}"
    >
      <view class="sidebar-icon">{{item.icon}}</view>
      <view class="sidebar-name">{{item.shortName}}</view>
      <view wx:if="{{selectedCounts[item.id] > 0}}" class="sidebar-badge">{{selectedCounts[item.id]}}</view>
    </view>
  </scroll-view>

  <scroll-view
    class="right-content"
    scroll-y="{{!draggingOptionId && !dragSaving}}"
    show-scrollbar="{{false}}"
    scroll-into-view="{{scrollIntoView}}"
    catch:touchmove="onOptionDragMove"
    catch:touchend="onOptionDragEnd"
    catch:touchcancel="onOptionDragCancel"
  >
    <view class="content-header">
      <text class="content-title">{{currentCategory.icon}} {{currentCategory.name}}</text>
    </view>

    <view wx:if="{{dragSaving}}" class="drag-saving">保存顺序中...</view>

    <view class="content-toolbar">
      <view class="search-bar">
        <text class="search-icon">⌕</text>
        <input
          class="search-input"
          value="{{searchQuery}}"
          placeholder="搜活动或补充说明"
          bind:input="onSearchInput"
          confirm-type="search"
          disabled="{{draggingOptionId || dragSaving}}"
        />
      </view>
      <view class="toolbar-actions">
        <view class="toolbar-btn {{draggingOptionId || dragSaving ? 'disabled' : ''}}" bind:tap="collapseAllOptionGroups">
          <text class="toolbar-btn-icon">{{allGroupsCollapsed ? '▾' : '▴'}}</text>
          <text>{{allGroupsCollapsed ? '全部展开' : '全部收起'}}</text>
        </view>
        <view class="toolbar-btn {{manageMode ? 'active' : ''}} {{draggingOptionId || dragSaving ? 'disabled' : ''}}" bind:tap="toggleManagementMode">
          {{manageMode ? '完成' : '管理'}}
        </view>
      </view>
    </view>

    <view wx:if="{{searchQuery}}" class="search-results">
      <view wx:if="{{searchResults.length === 0}}" class="search-empty">没有找到相关活动</view>
      <view
        wx:for="{{searchResults}}"
        wx:key="option.id"
        class="search-result-item"
        bind:tap="onSearchResultTap"
        data-result="{{item}}"
      >
        <view class="search-result-main">
          <text class="option-name">{{item.option.name}}</text>
          <text wx:if="{{item.option.description}}" class="option-desc">{{item.option.description}}</text>
        </view>
        <text class="search-result-meta">{{item.categoryName}} · {{item.groupName}}</text>
      </view>
    </view>

    <block wx:else>
      <view
        wx:for="{{currentOptionGroups}}"
        wx:key="id"
        wx:for-item="group"
        class="option-group option-group-dropzone {{dragTargetGroupId === group.id ? 'drag-target' : ''}}"
        data-group-id="{{group.id}}"
      >
        <view class="group-header" bind:tap="toggleOptionGroup" data-group-id="{{group.id}}">
          <view class="group-header-main">
            <text class="group-chevron">{{group.collapsed ? '▸' : '▾'}}</text>
            <text class="group-title">{{group.title}}</text>
          </view>
          <view
            class="group-plus"
            catch:tap="openOptionEditor"
            data-category-id="{{currentCategoryId}}"
            data-group-id="{{group.id}}"
          >
            ＋
          </view>
        </view>

        <view wx:if="{{!group.collapsed}}">
          <view wx:if="{{group.options.length === 0}}" class="option-empty">暂无活动</view>
          <view
            wx:for="{{group.options}}"
            wx:key="id"
            wx:for-item="item"
            class="option-item {{selectedIds[item.id] ? 'selected' : ''}} {{manageMode ? 'management' : ''}} {{draggingOptionId === item.id ? 'drag-placeholder' : ''}}"
            id="option-{{item.id}}"
            bind:tap="onToggleOption"
            data-option="{{item}}"
            data-option-id="{{item.id}}"
            data-group-id="{{group.id}}"
          >
            <view wx:if="{{!manageMode}}" class="option-checkbox">
              <view wx:if="{{selectedIds[item.id]}}" class="checkbox-checked">✓</view>
            </view>
            <view class="option-text">
              <text class="option-name">{{item.name}}</text>
              <text wx:if="{{item.description && draggingOptionId !== item.id}}" class="option-desc">{{item.description}}</text>
              <text wx:if="{{draggingOptionId === item.id}}" class="drag-placeholder-label">拖动到目标分组</text>
            </view>
            <view wx:if="{{manageMode}}" class="management-actions">
              <view
                class="drag-handle"
                catch:longpress="onOptionDragStart"
                data-option="{{item}}"
                data-group-id="{{group.id}}"
                aria-label="拖拽排序"
              >
                ☰
              </view>
              <view
                class="management-action"
                catch:tap="openOptionEditor"
                data-option="{{item}}"
                data-category-id="{{currentCategoryId}}"
                data-group-id="{{group.id}}"
              >
                ✎
              </view>
              <view
                class="management-action danger"
                catch:tap="onDeleteOption"
                data-option="{{item}}"
                data-category-id="{{currentCategoryId}}"
              >
                🗑
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <view wx:if="{{draggingOptionId}}" class="drag-ghost" style="top: {{dragY}}px;">
      <text class="drag-ghost-name">{{dragGhostName}}</text>
    </view>

    <view style="height: 24rpx;"></view>
  </scroll-view>
</view>

<view class="bottom-bar">
  <view class="count">已选 <em>{{totalCount}}</em> 项</view>
  <button class="send-btn {{totalCount === 0 ? 'btn-disabled' : ''}}" disabled="{{totalCount === 0}}" open-type="share">发送给 TA 💌</button>
</view>

<view wx:if="{{editorVisible}}" class="editor-overlay" catch:tap="closeOptionEditor">
  <view class="editor-modal" catch:tap="noop">
    <view class="editor-header">
      <text class="editor-title">{{editorMode === 'edit' ? '编辑活动' : '新增活动'}}</text>
      <view class="editor-close" bind:tap="closeOptionEditor">✕</view>
    </view>
    <text class="editor-meta">{{editorCategoryName}} · {{editorGroupName}}</text>

    <view class="editor-field">
      <text class="editor-label">名称</text>
      <input
        class="editor-input"
        value="{{editorName}}"
        maxlength="30"
        placeholder="最多 30 个字"
        bind:input="onEditorNameInput"
      />
    </view>

    <view class="editor-field">
      <text class="editor-label">补充说明</text>
      <textarea
        class="editor-textarea"
        value="{{editorDescription}}"
        maxlength="160"
        placeholder="最多 160 个字"
        auto-height
        bind:input="onEditorDescriptionInput"
      />
    </view>

    <view class="editor-actions">
      <view class="editor-btn secondary" bind:tap="closeOptionEditor">取消</view>
      <view class="editor-btn primary {{editorSaving ? 'disabled' : ''}}" bind:tap="saveOptionEditor">
        {{editorSaving ? '保存中...' : '保存'}}
      </view>
    </view>
  </view>
</view>
