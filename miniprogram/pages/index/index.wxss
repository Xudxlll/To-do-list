.main-layout {
  flex: 1;
  display: flex;
  overflow: hidden;
}

.left-sidebar {
  width: 170rpx;
  background: #fff;
  flex-shrink: 0;
}

.sidebar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 12rpx;
  position: relative;
}

.sidebar-item.disabled {
  opacity: 0.55;
}

.sidebar-item.active {
  background: var(--bg-primary);
  border-left: 6rpx solid var(--accent);
}

.sidebar-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
}

.sidebar-name {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.sidebar-item.active .sidebar-name {
  color: var(--accent);
  font-weight: 600;
}

.sidebar-badge {
  position: absolute;
  top: 10rpx;
  right: 6rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  border-radius: 14rpx;
  padding: 0 6rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 600;
  color: #fff;
  background: var(--accent);
}

.right-content {
  flex: 1;
  background: var(--bg-primary);
  padding: 0 24rpx 0;
  position: relative;
}

.content-header {
  padding: 24rpx 8rpx 12rpx;
}

.content-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.content-toolbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 0 20rpx;
}

.search-bar {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 76rpx;
  padding: 0 18rpx;
  background: #fff;
  border-radius: var(--radius-sm);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  color: var(--accent);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--text-primary);
}

.toolbar-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.toolbar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 76rpx;
  padding: 0 18rpx;
  border-radius: var(--radius-sm);
  background: #fff;
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.toolbar-btn.active {
  background: var(--accent);
  color: #fff;
}

.toolbar-btn.disabled {
  opacity: 0.55;
}

.toolbar-btn-icon {
  font-size: 20rpx;
}

.search-results {
  padding-bottom: 8rpx;
}

.search-empty {
  padding: 28rpx 0 18rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.search-result-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 22rpx 20rpx;
  margin-bottom: 10rpx;
  background: #fff;
  border-radius: var(--radius-sm);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.search-result-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.search-result-meta {
  font-size: 22rpx;
  color: var(--accent);
  line-height: 1.4;
}

.option-group {
  margin-bottom: 20rpx;
}

.drag-saving {
  margin: 0 4rpx 16rpx;
  padding: 14rpx 18rpx;
  border-radius: var(--radius-sm);
  background: #fff;
  color: var(--accent);
  font-size: 22rpx;
  line-height: 1.4;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.option-group-dropzone.drag-target {
  box-shadow: 0 0 0 2rpx var(--accent-light);
  border-radius: var(--radius-sm);
}

.group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin: 0 4rpx 12rpx;
}

.group-header-main {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.group-chevron {
  color: var(--accent);
  font-size: 22rpx;
  flex-shrink: 0;
}

.group-title {
  min-width: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--accent);
  line-height: 1.35;
}

.group-plus {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: var(--accent);
  font-size: 30rpx;
  line-height: 1;
  flex-shrink: 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.option-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 10rpx;
  background: #fff;
  border-radius: var(--radius-sm);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.option-item.selected {
  background: var(--accent-bg);
  border: 2rpx solid var(--accent-light);
}

.option-item.management {
  align-items: flex-start;
}

.option-item.drag-placeholder {
  border: 2rpx dashed var(--accent-light);
  background: rgba(255, 255, 255, 0.76);
}

.drag-drop-line {
  height: 4rpx;
  margin: -2rpx 18rpx 10rpx;
  border-radius: 4rpx;
  background: var(--accent);
  box-shadow: 0 0 12rpx rgba(255, 91, 122, 0.32);
}

.option-empty {
  padding: 22rpx 20rpx;
  margin-bottom: 10rpx;
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.72);
  color: var(--text-secondary);
  font-size: 22rpx;
  line-height: 1.45;
}

.option-checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid var(--accent-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox-checked {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}

.option-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.option-name {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.35;
}

.option-desc {
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--text-secondary);
}

.management-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  margin-left: 8rpx;
  align-self: center;
}

.management-action {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff0f3;
  color: var(--accent);
  font-size: 24rpx;
  line-height: 1;
  flex-shrink: 0;
}

.management-action.danger {
  background: #ffe7ea;
}

.drag-handle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff4f6;
  color: var(--accent);
  font-size: 28rpx;
  line-height: 1;
  flex-shrink: 0;
}

.drag-placeholder-label {
  font-size: 20rpx;
  line-height: 1.4;
  color: var(--accent);
}

.drag-ghost {
  position: fixed;
  left: 206rpx;
  right: 40rpx;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  background: #fff;
  border-radius: var(--radius-sm);
  box-shadow: 0 10rpx 32rpx rgba(0, 0, 0, 0.14);
  transform: translateY(-50%);
  z-index: 60;
  pointer-events: none;
  max-width: calc(100vw - 246rpx);
}

.drag-ghost-name {
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.35;
}

.editor-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx;
  background: rgba(0, 0, 0, 0.28);
  z-index: 99;
}

.editor-modal {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 24rpx 34rpx;
  box-sizing: border-box;
}

.editor-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.editor-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.editor-close {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff0f3;
  color: var(--accent);
  font-size: 24rpx;
  flex-shrink: 0;
}

.editor-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--text-secondary);
}

.editor-field {
  margin-top: 22rpx;
}

.editor-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.editor-input,
.editor-textarea {
  width: 100%;
  background: var(--bg-primary);
  border-radius: var(--radius-sm);
  padding: 18rpx 18rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: var(--text-primary);
}

.editor-input {
  height: 88rpx;
  line-height: 88rpx;
  padding-top: 0;
  padding-bottom: 0;
}

.editor-textarea {
  min-height: 180rpx;
}

.editor-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 28rpx;
}

.editor-btn {
  flex: 1;
  height: 80rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
}

.editor-btn.secondary {
  background: #f4f4f4;
  color: var(--text-secondary);
}

.editor-btn.primary {
  background: var(--accent);
  color: #fff;
}

.editor-btn.disabled {
  opacity: 0.6;
}
