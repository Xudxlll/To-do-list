@keyframes tileBreath {
  0%, 100% {
    opacity: 0.95;
  }
  50% {
    opacity: 1;
  }
}

.screen-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background:
    linear-gradient(180deg, rgba(255, 245, 245, 0.92) 0%, rgba(255, 245, 245, 0.1) 34%, rgba(255, 245, 245, 0.92) 100%),
    linear-gradient(90deg, rgba(255, 245, 245, 0.42) 0%, rgba(255, 245, 245, 0) 44%, rgba(255, 245, 245, 0.42) 100%);
  pointer-events: none;
}

.diary-entry {
  width: 224rpx;
  margin: 24rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 16rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #C45F72;
  box-shadow: 0 12rpx 34rpx rgba(120, 54, 69, 0.16);
}

.diary-entry-icon {
  font-size: 28rpx;
}

.diary-entry-text {
  font-size: 24rpx;
  font-weight: 700;
}

.hero-copy {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  top: 16rpx;
  z-index: 2;
  text-align: center;
}

.eyebrow {
  font-size: 22rpx;
  letter-spacing: 0;
  color: var(--accent);
  opacity: 0.82;
  margin-bottom: 14rpx;
}

.hero-title {
  font-size: 60rpx;
  line-height: 1.08;
  font-weight: 800;
}

.hero-subtitle {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

.welcome-actions {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 44rpx;
  z-index: 4;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.action-btn {
  width: 100%;
  border: none;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  padding: 24rpx 24rpx;
  line-height: 1.35;
}

.quiet-btn {
  color: var(--accent);
  background: var(--accent-bg);
  border: 3rpx solid var(--accent-light);
}

.primary-btn {
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
  box-shadow: 0 18rpx 44rpx rgba(255, 107, 129, 0.26);
}
