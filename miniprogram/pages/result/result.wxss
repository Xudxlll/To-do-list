.scrollarea {
  flex: 1;
  padding: 0 28rpx;
}

.reset-btn {
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 8rpx 0;
}

.summary-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 36rpx;
}

.summary-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.summary-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
}

.locked-badge {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--accent);
  background: var(--accent-bg);
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}

.partner-category {
  background: var(--bg-card);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}

.pcat-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.pcat-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.pcat-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--accent);
}

.pcat-options {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 14rpx;
}

.pcat-option {
  position: relative;
  z-index: 1;
  max-width: 100%;
  box-sizing: border-box;
  background: var(--accent-bg);
  color: var(--accent);
  font-size: 26rpx;
  line-height: 1.45;
  padding: 10rpx 22rpx;
  border-radius: 32rpx;
  border: 2rpx solid var(--accent-light);
  white-space: normal;
  word-break: break-word;
}

.pcat-option.is-custom {
  border-style: dashed;
  background: #FFF8F0;
  color: #E8943A;
  border-color: #F5D5A0;
}

.free-result-card {
  background:
    linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(255, 248, 241, 0.96));
  border-radius: var(--radius);
  padding: 34rpx 32rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid rgba(255, 179, 191, 0.48);
  box-shadow: var(--shadow);
}

.free-card-label {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 700;
  margin-bottom: 18rpx;
}

.free-card-text {
  font-size: 34rpx;
  line-height: 1.7;
  color: var(--text-primary);
  font-weight: 600;
  word-break: break-word;
}

.result-bar {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.action-btn {
  flex: 1;
  border: none;
  border-radius: 48rpx;
  padding: 22rpx 0;
  font-size: 30rpx;
  font-weight: 600;
}

.edit-btn {
  background: var(--accent-bg);
  color: var(--accent);
  border: 3rpx solid var(--accent-light);
}

.perfect-btn {
  background: linear-gradient(135deg, #FF6B81, #FF8E9E);
  color: #fff;
}
