page {
  background: var(--bg-primary);
}

.welcome-page {
  flex: 1;
  position: relative;
  overflow: hidden;
  background: var(--bg-primary);
  color: var(--text-primary);
}

.memory-collage {
  position: absolute;
  top: 306rpx;
  right: 0;
  bottom: 210rpx;
  left: 0;
  overflow: hidden;
}

.photo-tile {
  position: absolute;
  border-radius: 22rpx;
  overflow: hidden;
  background: var(--bg-card);
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 12rpx 32rpx rgba(255, 107, 129, 0.16);
  animation: tileBreath 6s ease-in-out infinite;
}

.memory-photo {
  width: 100%;
  height: 100%;
}

.photo-fallback {
  width: 100%;
  height: 100%;
  background:
    linear-gradient(160deg, rgba(255, 255, 255, 0.48), rgba(255, 255, 255, 0)),
    linear-gradient(135deg, #FFD5DD 0%, #FF8E9E 52%, #F4C7A1 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 18rpx;
  box-sizing: border-box;
}

.fallback-mark {
  width: 46rpx;
  height: 46rpx;
  border-radius: 23rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.fallback-text {
  font-size: 18rpx;
  line-height: 1.45;
  font-weight: 600;
}

