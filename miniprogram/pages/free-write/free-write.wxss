.free-page {
  flex: 1;
  background:
    linear-gradient(180deg, #FFF5F5 0%, #FFF9F1 46%, #F7FBFF 100%);
  padding: 34rpx 32rpx 44rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.free-header {
  padding: 18rpx 4rpx 36rpx;
}

.free-kicker {
  font-size: 22rpx;
  color: #B77986;
  letter-spacing: 0;
  margin-bottom: 16rpx;
}

.free-title {
  font-size: 54rpx;
  line-height: 1.18;
  color: var(--text-primary);
  font-weight: 800;
}

.free-subtitle {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: var(--text-secondary);
}

.text-panel {
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(255, 179, 191, 0.45);
  border-radius: 28rpx;
  box-shadow: 0 18rpx 60rpx rgba(255, 107, 129, 0.12);
  padding: 28rpx;
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
}

.free-textarea {
  width: 100%;
  flex: 1;
  min-height: 330rpx;
  font-size: 32rpx;
  line-height: 1.7;
  color: var(--text-primary);
}

.counter {
  text-align: right;
  color: #B8A8A8;
  font-size: 24rpx;
  margin-top: 18rpx;
}

.send-area {
  margin-top: auto;
  padding-top: 40rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.send-free-btn {
  width: 100%;
  border: none;
  border-radius: 999rpx;
  padding: 24rpx 24rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #FF6B81, #FF9A8B);
  box-shadow: 0 18rpx 44rpx rgba(255, 107, 129, 0.26);
}

.send-free-btn.btn-disabled {
  background: #E0E0E0;
  color: #B0B0B0;
  box-shadow: none;
}
